# =============================================================================
# V Mingle Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================================


# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
# CRITICAL: Set this to the canonical production domain.
# Drives all canonical URLs, sitemap, robots.txt, OG tags, and structured data.
NEXT_PUBLIC_SITE_URL=https://vmingle.in

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexuschat:nexuschat_dev@localhost:5432/nexuschat
POSTGRES_USER=nexuschat
POSTGRES_PASSWORD=nexuschat_dev
POSTGRES_DB=nexuschat

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── TURN Server ──────────────────────────────────────────────────────────────
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=nexuschat
TURN_PASSWORD=change_me_in_production

# ── Security ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_64_char_string_in_production
CORS_ORIGIN=http://localhost:3000

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# ── Real-Time Long-Hair Detection ─────────────────────────────────────────────
DETECTION_DESTINATION_IP=127.0.0.1
DETECTION_DESTINATION_PORT=8080
DETECTION_FPS=5
DETECTION_RETRY_COUNT=3
DETECTION_TIMEOUT_MS=5000
DETECTION_ENABLED=true

